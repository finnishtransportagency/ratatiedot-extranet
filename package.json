{
  "name": "ratatiedot-extranet",
  "version": "1.0.0",
  "private": true,
  "description": "Väyläviraston ratatiedot extranet",
  "main": "index.js",
  "engines": {
    "node": "^22.22.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "lerna run build",
    "build:frontend": "pnpm --filter frontend build",
    "deploy:node-server": "pnpm --filter node-server --prod deploy packages/deploy/node-server",
    "ci": "pnpm ci",
    "dev-client": "pnpm --filter frontend start",
    "dev-server": "pnpm --filter server start",
    "dev-node": "pnpm --filter node-server watch",
    "dev": "concurrently \"pnpm run dev-server\" \"pnpm run dev-client\"",
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "test": "lerna run test --no-sort",
    "test:client": "pnpm --filter frontend test",
    "test:client:ci": "pnpm --filter frontend test:no-watch",
    "test:server": "pnpm --filter server test",
    "cdk": "cdk",
    "prelocal:synth": "pnpm run prisma:generate",
    "local:synth": "ENVIRONMENT=local BRANCH=local STACK_ID=local cdk --app \"tsx bin/rataextra\" -o cdk.rataextra synth",
    "sam:invoke": "ENVIRONMENT=local sam local invoke -t ./cdk.rataextra/rataextra.template.json $npm_config_handler --profile $npm_config_profile",
    "sam:synthinvoke": "pnpm run local:synth && pnpm run sam:invoke",
    "pipeline:synth": "cross-env ENVIRONMENT=$npm_config_environment BRANCH=$npm_config_branch STACK_ID=$npm_config_stackid cdk synth",
    "pipeline:diff": "cross-env ENVIRONMENT=$npm_config_environment BRANCH=$npm_config_branch STACK_ID=$npm_config_stackid cdk diff",
    "pipeline:deploy": "cross-env ENVIRONMENT=$npm_config_environment BRANCH=$npm_config_branch STACK_ID=$npm_config_stackid cdk deploy stack-pipeline-rataextra-$npm_config_stackid --no-rollback",
    "prisma:format": "prisma format --schema packages/server/prisma/schema.prisma",
    "prisma:generate": "pnpm --filter server run prisma:generate",
    "local:db:migrate": "cd packages/server && npm run loadenv && prisma migrate dev --name init --schema prisma/schema.prisma",
    "local:db:populate": "cd packages/server && ./populate-local-db.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/finnishtransportagency/ratatiedot-extranet.git"
  },
  "author": "",
  "license": "EUPL-1.2",
  "bugs": {
    "url": "https://github.com/finnishtransportagency/ratatiedot-extranet/issues"
  },
  "homepage": "https://github.com/finnishtransportagency/ratatiedot-extranet#readme",
  "dependencies": {
    "axios": "1.15.0",
    "lodash": "4.17.23"
  },
  "overrides": {
    "axios": "1.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.2",
    "@types/lodash": "4.17.23",
    "@types/node": "22.19.7",
    "@typescript-eslint/eslint-plugin": "8.53.1",
    "@typescript-eslint/parser": "8.53.1",
    "aws-cdk": "2.1101.0",
    "aws-cdk-lib": "2.235.1",
    "concurrently": "9.2.1",
    "constructs": "10.2.69",
    "cross-env": "10.1.0",
    "cypress": "15.9.0",
    "esbuild": "0.27.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "lerna": "9.0.3",
    "lint-staged": "16.2.7",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,json,jsx,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "pnpm exec eslint --fix",
      "prettier --write --parser=typescript"
    ]
  },
  "workspaces": [
    "packages/frontend",
    "packages/server"
  ],
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "packageManager": "pnpm@11.20.0"
}
